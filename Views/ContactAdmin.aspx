<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ContactAdmin.aspx.cs" Inherits="HospitalMSWebApp.Views.ContactAdmin" %>
<!doctype html><html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Guardian Health — Help and access</title><link rel="stylesheet" href="../Content/guardian.css?v=20261008.r2" /><link rel="stylesheet" href="../Content/guardian-auth.css?v=20261008.r2" /></head><body class="gh-auth-simple"><main class="gh-auth-card"><p class="gh-eyebrow">GUARDIAN HEALTH HOSPITAL</p><h1>Account assistance</h1><p>Request help with hospital account access. Do not include passwords or medical information.</p><form id="form1" runat="server"><div id="alertBox" runat="server" class="alert" role="alert"></div><div class="form-grid"><label for="nameTb">Full name<input type="text" id="nameTb" runat="server" maxlength="100" required="required" /></label><label for="emailTb">Email address<input type="email" id="emailTb" runat="server" maxlength="100" required="required" /></label><label for="requestTypeCb">Request type<asp:DropDownList ID="requestTypeCb" runat="server"><asp:ListItem Value="">Choose a request</asp:ListItem><asp:ListItem>New Account</asp:ListItem><asp:ListItem>Account Unlock</asp:ListItem><asp:ListItem>Password Reset</asp:ListItem><asp:ListItem>Technical Issue</asp:ListItem><asp:ListItem>Other</asp:ListItem></asp:DropDownList></label><label for="messageTb">How can we help?<textarea id="messageTb" runat="server" maxlength="2000" required="required"></textarea></label><asp:Button ID="submitBtn" runat="server" Text="Send request" OnClick="submitBtn_Click" /></div></form><nav class="gh-help-links" aria-label="Help navigation"><a href="login.aspx">Sign in</a><a href="HelpCenter.aspx">Help centre</a><a href="Guest/Home.aspx">Hospital home</a></nav></main><script src="../Scripts/guardian.js?v=20261008.r2" defer></script></body></html>
