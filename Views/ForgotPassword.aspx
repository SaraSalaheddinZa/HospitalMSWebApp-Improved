<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ForgotPassword.aspx.cs" Inherits="HospitalMSWebApp.Views.ForgotPassword" %>
<!doctype html><html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Guardian Health — Password recovery</title><link rel="stylesheet" href="../Content/guardian.css?v=20261008.r2" /><link rel="stylesheet" href="../Content/guardian-auth.css?v=20261008.r2" /></head><body class="gh-auth-simple"><main class="gh-auth-card"><p class="gh-eyebrow">GUARDIAN HEALTH / ACCOUNT RECOVERY</p><h1>Forgot your password?</h1><p>Enter your account email and role to request a secure, time-limited reset link.</p><form id="form1" runat="server"><div id="alertBox" runat="server" class="alert" role="alert"></div><div class="gh-auth-field"><asp:Label AssociatedControlID="emailTb" runat="server" Text="Email Address" /><asp:TextBox ID="emailTb" runat="server" TextMode="Email" required="required" autocomplete="email" /></div><div class="gh-auth-field" id="roleSection" runat="server"><asp:Label AssociatedControlID="roleCb" runat="server" Text="Your Role" /><asp:DropDownList ID="roleCb" runat="server" required="required"><asp:ListItem Value="">Choose your role</asp:ListItem><asp:ListItem Value="Admin">System Administrator</asp:ListItem><asp:ListItem Value="Doctor">Doctor</asp:ListItem><asp:ListItem Value="Receptionist">Receptionist</asp:ListItem><asp:ListItem Value="Laboratorian">Laboratory Technician</asp:ListItem><asp:ListItem Value="Nurse">Nurse</asp:ListItem><asp:ListItem Value="Pharmacist">Pharmacist</asp:ListItem><asp:ListItem Value="Patient">Patient Portal</asp:ListItem></asp:DropDownList></div><asp:Button ID="submitBtn" runat="server" Text="Send Reset Link" CssClass="gh-auth-submit" OnClick="submitBtn_Click" /></form><a href="login.aspx">Return to sign in</a><p class="gh-auth-security">If you did not request a password change, your account will remain unchanged.</p></main></body></html>
