<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Support.aspx.cs" Inherits="HospitalMSWebApp.Views.Support" %>
<!doctype html><html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Guardian Health — Help and access</title><link rel="stylesheet" href="../Content/guardian.css?v=20261008.r2" /><link rel="stylesheet" href="../Content/guardian-auth.css?v=20261008.r2" /></head><body class="gh-auth-simple"><main class="gh-auth-card"><p class="gh-eyebrow">GUARDIAN HEALTH HOSPITAL</p><h1>Technical support</h1><p>Tell us about an issue accessing or using Guardian Health. Do not include patient details, medical information or passwords.</p><form id="form1" runat="server"><div id="alertBox" runat="server" class="alert" role="alert"></div><div class="form-grid"><label for="nameTb">Full name<asp:TextBox ID="nameTb" runat="server" MaxLength="100" required="required" /></label><label for="emailTb">Email address<asp:TextBox ID="emailTb" runat="server" TextMode="Email" MaxLength="100" required="required" /></label><label for="categoryCb">Category<asp:DropDownList ID="categoryCb" runat="server"><asp:ListItem Value="">Choose a category</asp:ListItem><asp:ListItem>Login Issue</asp:ListItem><asp:ListItem>System Error</asp:ListItem><asp:ListItem>Feature Request</asp:ListItem><asp:ListItem>Data Issue</asp:ListItem><asp:ListItem>Performance</asp:ListItem><asp:ListItem>Other</asp:ListItem></asp:DropDownList></label><label for="priorityCb">Priority<asp:DropDownList ID="priorityCb" runat="server"><asp:ListItem>Low</asp:ListItem><asp:ListItem Selected="True">Medium</asp:ListItem><asp:ListItem>High</asp:ListItem><asp:ListItem>Critical</asp:ListItem></asp:DropDownList></label><label for="subjectTb">Subject<input type="text" id="subjectTb" runat="server" maxlength="150" required="required" /></label><label for="descriptionTb">Describe the issue<asp:TextBox ID="descriptionTb" runat="server" TextMode="MultiLine" required="required" /></label><asp:Button ID="submitBtn" runat="server" Text="Submit support request" OnClick="submitBtn_Click" /></div></form><nav class="gh-help-links" aria-label="Help navigation"><a href="login.aspx">Sign in</a><a href="HelpCenter.aspx">Help centre</a><a href="Guest/Home.aspx">Hospital home</a></nav></main><script src="../Scripts/guardian.js?v=20261008.r2" defer></script></body></html>
